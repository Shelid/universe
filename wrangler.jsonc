{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universe-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
